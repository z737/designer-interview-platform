# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
#
# There is no sign-in: every request goes out as the anon role and the tables are
# open to it. The anon key is public by design (it ships in the browser bundle),
# so anyone who can reach this app can read and write candidate data. Keep it on
# localhost or behind a VPN. Never put the service_role key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
